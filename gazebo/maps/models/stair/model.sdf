<?xml version="1.0"?>
<sdf version="1.11">
  <model name="stair">
    <link name="body">
      <inertial auto="true" />
      <collision name="collision">
        <density>10.0</density>
        <geometry>
          <mesh optimization="convex_decomposition">
            <uri>models://stair/mesh.stl</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>models://stair/mesh.stl</uri>
          </mesh>
        </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
      </visual>
    </link>
  </model>
</sdf>